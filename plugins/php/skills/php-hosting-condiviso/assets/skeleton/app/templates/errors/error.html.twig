{% extends 'layout.html.twig' %}

{% set titles = {403: 'Accesso negato', 404: 'Pagina non trovata', 405: 'Metodo non consentito', 500: 'Errore del server'} %}

{% block title %}{{ titles[status] ?? 'Errore' }}{% endblock %}

{% block content %}
    <h1>{{ titles[status] ?? 'Errore' }}</h1>
    <p>Codice {{ status }}. <a href="{{ path('/') }}">Torna alla home</a></p>
    {% if details %}
        <h2>{{ details.class }}</h2>
        <p>{{ details.message }}</p>
        <p><code>{{ details.where }}</code></p>
        <pre>{{ details.trace }}</pre>
    {% endif %}
{% endblock %}
