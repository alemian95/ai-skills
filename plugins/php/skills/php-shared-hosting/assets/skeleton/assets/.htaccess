# Executable files are never served or run from assets/, even if one ends up here by mistake or via an upload.
<FilesMatch "\.(php\d?|phtml|pht|phps|phar|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Long cache: asset() adds ?v=<modification date>, so a new upload changes the URL.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 year"
</IfModule>
